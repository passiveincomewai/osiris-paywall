// Prisma + PostgreSQL schema for the OSIRIS paywall.
// Auth.js v5 adapter models (User/Account/Session/VerificationToken)
// plus a first-class Subscription ledger written ONLY by the Stripe webhook.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  // bcrypt hash for email+password sign-in. Null for OAuth-only / magic-link users.
  passwordHash  String?
  // Phone number collected at Pro checkout (account claim form).
  phone         String?
  // Lifecycle marketing opt-out (src/lib/lifecycle). Set by the
  // unsubscribe link in marketing emails; transactional mail (trial
  // started / trial ending) is not gated on it.
  emailOptOut   Boolean        @default(false)
  // Support WorldEye donations (src/lib/donate): set by the Stripe
  // webhook when a donation completes for this account. Supporters
  // stop seeing donation prompts. NOT a plan/entitlement flag.
  supporter     Boolean        @default(false)
  donations     Donation[]
  lifecycleEmails LifecycleEmailLog[]
  image         String?
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  giftsPurchased GiftSubscription[] @relation("GiftBuyer")
  giftsRedeemed  GiftSubscription[] @relation("GiftRedeemer")
  creatorApplications CreatorApplication[]
  affiliateProfile AffiliateProfile?
  affiliateTermsAcceptances AffiliateTermsAcceptance[]
  cameraBonusAccount CameraBonusAccount?
  savedCameras  SavedCamera[]
  skiResortFollows SkiResortFollow[]
  skiTripReminders SkiTripReminder[]
  skiEmailSendLogs SkiEmailSendLog[]
  skiPassSeason SkiPassSeason?
  skiPassDays SkiPassDay[]
  clipMetas     ClipMeta[]
  clipShares    ClipShare[]
  cameraCollections CameraCollection[]
  enterpriseApiKeys EnterpriseApiKey[]
  claimedShareIdentity ShareIdentity? @relation("ShareIdentityClaim")
  alertRules AlertRule[]
  vipPlaces VipPlace[]
  eventAlertRules EventAlertRule[]
  eventAlertEvents EventAlertEvent[]
  auroraAlertSubscriptions AuroraAlertSubscription[]
  pushSubscriptions PushSubscription[]
  savedViews SavedView[]
  vipBriefPref VipBriefPref?
  organizationsOwned Organization[] @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  teamInvitationsSent TeamInvitation[] @relation("InviteSender")
  teamActivityActions TeamActivityLog[] @relation("ActivityActor")
  accountPreference UserPreference?
  totp          UserTotp?
  deviceSessions UserDeviceSession[]
  signInEvents  UserSignInEvent[]
  referralCodeAliases ReferralCodeAlias[]
  ambientStreamKey AmbientStreamKey?
  frInvestigatorConversations FrInvestigatorConversation[]
  frCases FrCase[]
  frReports FrReport[]
  fraudRadarSubscription FraudRadarSubscription?
  deletionRequestedAt DateTime?
  deletionScheduledFor DateTime?
  // "How did you find out about us?" — set once from account settings
  // (or left null). Values are the keys in src/lib/discovery-sources.ts.
  discoverySource String?
  discoveryDetail String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sharedCollections SharedCollection[]
}

// ── Support WorldEye donations (2026-11-09) ─────────────────────
// One row per completed donation, written ONLY by the Stripe webhook
// (src/lib/donate/record). stripeRef is the checkout session id for
// the first payment or the invoice id for a monthly renewal — unique,
// so Stripe replays can never double-record. A donation NEVER grants
// plan access; the webhook's donation branch is disjoint from the
// subscription sync (see src/app/api/webhooks/stripe/route.ts).
model Donation {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String?
  amountCents Int
  currency    String   @default("usd")
  // "once" | "monthly" (DonateFrequency in src/lib/donate/config).
  frequency   String
  // Placement token the donor came from (e.g. "gods_eye_view").
  source      String?
  stripeRef   String   @unique
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ── Account settings expansion (2026-10-22) ─────────────────────────
// One preference row is the source of truth for user-level choices.
// Email toggles in this row are also the lifecycle-email opt-out store:
// senders must consult it before trial, digest, product, or affiliate
// marketing mail. Security/device rows support the settings surfaces;
// Auth.js itself remains JWT-based (see REPORT).
model UserPreference {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  homeLabel String?
  homeLat   Float?
  homeLng   Float?
  defaultLayers String[] @default([])
  units     String @default("imperial") // imperial | metric
  timezone  String?
  clockFormat String @default("12") // 12 | 24
  defaultMapStyle String @default("standard") // standard | tactical-dark | night-vision
  performanceMode Boolean @default(false)
  showStatusTicker Boolean @default(false)

  cameraGridDensity String @default("comfortable") // comfortable | compact
  cameraPreviewRefreshSeconds Int @default(30)
  cameraAutoplay Boolean @default(true)

  quietHoursEnabled Boolean @default(false)
  quietHoursStart String @default("22:00")
  quietHoursEnd   String @default("07:00")
  cameraAlertChannel String @default("email") // email | push | both | none
  eventAlertChannel  String @default("email") // email | push | both | none

  recordingClipSeconds Int @default(60)
  recordingQuality String @default("balanced") // efficient | balanced | high

  emailTrialReminders Boolean @default(true)
  emailWeeklyDigest Boolean @default(false)
  emailProductNews Boolean @default(true)
  emailAffiliateUpdates Boolean @default(true)
  digestEnabled Boolean @default(false)
  digestRegions String[] @default([])
  digestLastSentAt DateTime?

  publicProfile Boolean @default(true)
  shareVisibility String @default("public") // public | unlisted
  billingEmail String?

  // Globe right tool strip customization (account settings → Sidebar
  // navigation): the user's tool order + hidden tools. Ids are the
  // canonical set in src/lib/sidebar-tools.ts; empty = defaults.
  sidebarToolOrder String[] @default([])
  sidebarToolHidden String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserTotp {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AES-256-GCM encrypted base32 secret; never store the secret in plain text.
  secretEncrypted String
  enabledAt DateTime?
  backupCodeHashes String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDeviceSession {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  label     String
  userAgent String? @db.VarChar(500)
  ipHash    String?
  approximateLocation String?
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, revokedAt, lastSeenAt])
}

model UserSignInEvent {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  deviceLabel String
  ipHash    String?
  approximateLocation String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, deviceId, createdAt])
}

// Every former custom referral code remains a permanent alias for the
// same affiliate profile, so links already shared keep crediting their
// owner after the canonical custom code changes.
model ReferralCodeAlias {
  id        String @id @default(cuid())
  affiliateProfileId String
  affiliate AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String @unique
  createdAt DateTime @default(now())

  @@index([affiliateProfileId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  paused
  incomplete
  incomplete_expired
  unpaid
}

enum GiftSubscriptionStatus {
  pending
  paid
  redeemed
  expired
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

// ── Gift subscriptions (2026-10-31) ──────────────────────────────────
// A buyer purchases ONE prepaid term of a grid plan for a recipient
// (src/lib/billing/gift.ts). The Stripe subscription itself never
// entitles anyone (the webhook skips gift subs); this row is the gift
// of record: purchase state, the paid period, and — once the recipient
// claims it — the redemption. The recipient's entitlement is a
// Subscription row with synthetic "gift_<id>" Stripe ids (comp
// pattern) carrying the real gifted price id and this row's period.
model GiftSubscription {
  id                      String                 @id @default(cuid())
  // Bearer redemption token, delivered to the recipient by email.
  code                    String                 @unique
  buyerUserId             String?
  buyer                   User?                  @relation("GiftBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerEmail              String
  recipientEmail          String
  // One of the nine grid PlanKeys (src/lib/billing/plans.ts).
  planKey                 String
  stripePriceId           String
  status                  GiftSubscriptionStatus @default(pending)
  stripeCheckoutSessionId String?                @unique
  stripeSubscriptionId    String?                @unique
  // The prepaid term, copied from the Stripe subscription at fulfilment.
  periodStart             DateTime?
  periodEnd               DateTime?
  redeemedByUserId        String?
  redeemedBy              User?                  @relation("GiftRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedAt              DateTime?

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([recipientEmail])
  @@index([status])
}

// ── WorldEye Ambient: YouTube restream credentials ───────────────────
// One row per member who uses Stream to YouTube. The member's own
// YouTube stream key is stored AES-256-GCM-encrypted
// (src/lib/ambient/stream-key-crypto) — never plaintext, never
// returned by an API. The relay host authenticates to
// /api/ambient/relay/playlist with a per-member relay token; only
// the token's SHA-256 hash is stored.
model AmbientStreamKey {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyCiphertext  String
  relayTokenHash String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Creator free-Pro program ───────────────────────────────────────────
// Creators with 25k+ followers apply here; an admin verifies the claimed
// audience and approves → a comp Subscription (see src/lib/pro/comp.ts)
// grants 12 months of Pro. Follower counts are self-reported until review.
model CreatorApplication {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform   String // instagram | tiktok | youtube | x | twitch | other
  handle     String
  profileUrl String
  followers  Int // self-reported; verified at admin review
  status     String    @default("pending") // pending | approved | rejected

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status, createdAt])
}

// ── WorldEye Affiliate System ──────────────────────────────────────────
// Money flows: Stripe webhook (invoice.payment_succeeded) → Commission rows
// (idempotent per invoice+level) → 30-day hold → available → payout request
// → admin approval → paid. XP flows through XPEvent (idempotent per key).

enum AffiliateStatus {
  pending
  active
  suspended
  banned
  // Admin-removed affiliate role: blocks dashboard/Studio access and new
  // attributions (all gates key on status === "active"); history preserved,
  // reactivatable by setting status back to active.
  removed
}

model AffiliateProfile {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  referralCode  String          @unique
  customCode    String?         @unique
  status        AffiliateStatus @default(pending)
  xp            Int             @default(0)

  // Tiered audience discount code (Stripe promotion code, % off the
  // buyer's first payment — see src/lib/affiliate/discount.ts). The code
  // string/pct are stored even before Stripe sync so the site can show
  // intent; stripePromotionCodeId is set only once Stripe confirms.
  discountCode          String?   @unique
  discountPct           Int?
  stripePromotionCodeId String?
  discountSyncedAt      DateTime?

  // Network: who recruited this affiliate (affiliate→affiliate chain for L2/L3)
  recruitedByProfileId String?
  recruitedBy          AffiliateProfile?  @relation("RecruitChain", fields: [recruitedByProfileId], references: [id], onDelete: SetNull)
  recruits             AffiliateProfile[] @relation("RecruitChain")

  leaderboardOptOut Boolean @default(false)
  payoutEmail       String?
  payoutMethod      String? // "venmo" | "stripe_connect" | "manual" (legacy: "paypal" — history only)
  // Venmo payout handle (live-flow payout method since 2026-10-30). Stored
  // normalized without the leading "@". Legacy PayPal values are never
  // migrated or deleted; they only live on in historical records.
  venmoHandle       String?
  // Personal payout threshold (cents). Null = use the program minimum.
  // A payout can only be requested at max(program min, this value).
  payoutThresholdCents Int?
  // Cinematic Director tools on the globe: an affiliate-panel switch.
  // DEFAULT OFF — the director renders only when this is true.
  directorEnabled   Boolean @default(false)

  // Marketing Studio Phase 4: public link-in-bio showcase opt-in (featured
  // creations appear on /bio/[code] only when this is true) and the
  // ambassador flag (approved AmbassadorApplication → ambassador template
  // category + early-access treatment in the Studio).
  showcaseEnabled Boolean @default(false)
  isAmbassador    Boolean @default(false)

  clicks        ReferralClick[]
  trackingLinks AffiliateTrackingLink[]
  notifications AffiliateNotification[]
  codeAliases   ReferralCodeAlias[]
  attributions  ReferralAttribution[] @relation("AffiliateAttributions")
  commissions   Commission[]
  payouts       Payout[]
  xpEvents      XPEvent[]
  challengeProgress ChallengeProgress[]
  creations     StudioCreation[]
  creditAccount StudioCreditAccount?
  creditLedger  StudioCreditLedger[]
  generationJobs GenerationJob[]
  badges        AffiliateBadge[]
  ambassadorApplications AmbassadorApplication[]
  campaignParticipations StudioCampaignParticipation[]
  dropClaims    StudioDropClaim[]
  studioProjects StudioProject[]
  studioPosts   StudioPost[]
  templateUsages AffiliateTemplateUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recruitedByProfileId])
}

// Resources page: per-affiliate "mark as used / posted" state for the
// copy templates (captions, email templates, video scripts). Purely
// additive bookkeeping — no conversion attribution is stored here,
// because per-template conversions are not tracked anywhere.

model AffiliateTemplateUsage {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  templateKind       String // "caption" | "email" | "script"
  templateId         String
  usedAt             DateTime?
  postedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([affiliateProfileId, templateKind, templateId])
  @@index([affiliateProfileId])
}

// A signed-in user's recorded acceptance of the affiliate program terms
// (lib/affiliate/terms). Written by POST /api/affiliate/accept-terms —
// the demo join flow records it immediately before enrolment via
// /api/affiliate/join. One row per user per terms version.
model AffiliateTermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion String
  source       String   @default("demo")
  acceptedAt   DateTime @default(now())

  @@unique([userId, termsVersion])
  @@index([userId])
}

model ReferralClick {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  ipHash    String
  userAgent String? @db.VarChar(300)
  path      String? @db.VarChar(300)

  // Tracking-link attribution (affiliate-suite): set when the visit came
  // through one of the affiliate's labeled tracking links (?t=<slug>).
  trackingLinkId String?
  trackingLink   AffiliateTrackingLink? @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  // Source capture going forward (null on rows written before this
  // existed — reports label those "not tracked", never guess).
  referrer    String? @db.VarChar(300)
  utmSource   String? @db.VarChar(120)
  utmMedium   String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)
  utmContent  String? @db.VarChar(120)

  createdAt DateTime @default(now())

  // Anti-abuse: one counted click per visitor-hash per affiliate per day
  @@index([affiliateProfileId, ipHash, createdAt])
  @@index([affiliateProfileId, trackingLinkId, createdAt])
  @@index([createdAt])
}

// ── Affiliate-suite: labeled tracking links + in-panel notifications ────
// Extra share links an affiliate creates per channel (newsletter, a
// specific video, a community). The primary referral code stays the
// identity; a tracking link is just a labeled ?t=<slug> on top of it, so
// per-link stats never fork attribution.
model AffiliateTrackingLink {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  label String @db.VarChar(80)
  slug  String @db.VarChar(32) // same alphabet as referral codes

  clicks ReferralClick[]

  createdAt DateTime @default(now())

  @@unique([affiliateProfileId, slug])
  @@index([affiliateProfileId, createdAt])
}

// In-dashboard notification center rows. Generated lazily from the real
// source tables (attributions, commissions, payouts) by
// src/lib/affiliate/notifications.ts with idempotency keys, so a
// notification can never be duplicated by a re-sync.
model AffiliateNotification {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  type  String // referral_signup | referral_converted | first_commission | payout_paid | payout_rejected
  title String @db.VarChar(160)
  body  String @db.Text
  href  String? @db.VarChar(300)

  idempotencyKey String    @unique
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([affiliateProfileId, readAt, createdAt])
}

model ReferralAttribution {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation("AffiliateAttributions", fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  // The referred end-user (one user can only ever be attributed once)
  referredUserId String           @unique
  clickId       String?
  createdAt     DateTime         @default(now())
  // 30-day attribution window (configurable)
  expiresAt     DateTime
  convertedAt   DateTime?

  @@index([affiliateProfileId])
}

// ── Invite-a-friend camera bonus ─────────────────────────────────────
// A signed-in user earns +15 camera opens when a friend completes
// signup through their /ref link (i.e. a ReferralAttribution row for
// the friend names the user's affiliate profile). The grant ledger
// makes the award one-per-invited-account, ever; the account row is
// the inviter's spendable balance, decremented server-side as
// beyond-base camera opens are consumed (lib/camera-bonus.ts).
model CameraBonusAccount {
  userId    String   @id
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CameraBonusGrant {
  id            String   @id @default(cuid())
  // One grant per invited account, ever — signup retries, repeat
  // sign-in syncs and webhook replays all hit this unique key and stop.
  inviteeUserId String   @unique
  inviterUserId String
  amount        Int      @default(15)
  createdAt     DateTime @default(now())

  @@index([inviterUserId])
}

// ── Invite-a-friend Pro-days reward ─────────────────────────────────
// A signed-in user earns +7 days of Pro when a friend who joined
// through their /ref link verifies their email (lib/invite-pro). The
// days are granted ONLY through the comp engine (synthetic comp
// subscription rows) — a real Stripe subscription is never touched.
// The ledger keys the reward to the invited account: one reward per
// referred account, ever. status:
//   granted — the comp days were applied to the inviter (appliedAt);
//   banked  — the inviter had a real Stripe subscription row, which
//             the comp engine never touches; the days sit here and
//             are applied once that row is gone (the Stripe webhook
//             deletes it when the paid sub ends);
//   capped  — the inviter already had 5 rewarded invites in that
//             calendar month; recorded (with the nominal days) so
//             this invitee can never pay out on a later re-fire.
model InviteProGrant {
  id            String    @id @default(cuid())
  inviteeUserId String    @unique
  inviterUserId String
  days          Int       @default(7)
  status        String    @default("granted")
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  @@index([inviterUserId])
  @@index([inviterUserId, createdAt])
}

// ── Universal share identity ─────────────────────────────────────────
// Everyone gets a personal share code — the affiliate link system,
// opened to visitors who have no account. A signed-in user's share
// code IS their affiliate code (AffiliateProfile.referralCode /
// customCode — no second code is minted for them). A signed-out
// visitor's browser holds a device token (localStorage); the server
// mints one ShareIdentity per token. When that device later signs up
// or logs in, the identity is CLAIMED by the account (one-time,
// first-claim-wins: claimedByUserId is unique and never reassigned) —
// as their affiliate referralCode if they have no profile yet, or as
// an alias that keeps resolving to their profile. Signups recorded
// against the code before the claim (ShareReferral) are flushed into
// real ReferralAttribution rows at claim time, so pre-claim sharing
// counts exactly like affiliate sharing.
model ShareIdentity {
  id String @id @default(cuid())

  // Public share code. Same alphabet/length rules as affiliate codes
  // (REF_CODE_RE); uniqueness against affiliate codes is enforced at
  // mint time across both tables.
  code String @unique

  // sha256 of the device token the visitor's browser presents.
  deviceTokenHash String @unique

  claimedByUserId String?   @unique
  claimedBy       User?     @relation("ShareIdentityClaim", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedAt       DateTime?

  // Mint rate limiting: hashed IP of the minting request.
  mintIpHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks    ShareClick[]
  referrals ShareReferral[]

  @@index([mintIpHash, createdAt])
}

model ShareClick {
  id              String        @id @default(cuid())
  shareIdentityId String
  shareIdentity   ShareIdentity @relation(fields: [shareIdentityId], references: [id], onDelete: Cascade)

  ipHash    String
  userAgent String? @db.VarChar(300)
  path      String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([shareIdentityId, ipHash, createdAt])
  @@index([createdAt])
}

model ShareReferral {
  id              String        @id @default(cuid())
  shareIdentityId String
  shareIdentity   ShareIdentity @relation(fields: [shareIdentityId], references: [id], onDelete: Cascade)

  // One user can only ever be share-attributed once (first code wins),
  // mirroring ReferralAttribution.referredUserId.
  referredUserId String   @unique
  // Set when the identity's claim converted this pending row into a
  // real ReferralAttribution (+ invite camera bonus) for the claimer.
  flushedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([shareIdentityId])
}

enum CommissionStatus {
  pending    // within holding period
  available  // holding elapsed, payable
  requested  // included in a payout request
  paid
  reversed   // refunded / charged back
}

model Commission {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  referredUserId   String?
  stripeInvoiceId  String?
  stripeCustomerId String?
  level            Int // 1 = direct, 2/3 = overrides
  amountCents      Int
  currency         String            @default("usd")
  status           CommissionStatus  @default(pending)
  availableAt      DateTime
  // Idempotency: one commission per invoice per level, replays safe
  idempotencyKey   String            @unique

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateProfileId, status])
  @@index([stripeInvoiceId])
}

enum PayoutStatus {
  requested
  approved
  processing
  paid
  rejected
}

// ── In-house site analytics (page views + time on site) ──────────────────
// Populated by <AnalyticsTracker/> via /api/analytics/track. Powers /admin.
model PageView {
  id         String   @id @default(cuid())
  path       String
  sessionId  String
  userId     String?
  // Seconds the page was visible, reported on page hide. Null if unknown.
  durationSec Int?
  referrer   String?
  // Optional event name (e.g. "globe_reached" scroll-depth). Null = plain page view.
  event      String?
  // First-touch UTM attribution, captured by <AnalyticsTracker/> from the
  // landing URL. Powers campaign attribution in the Growth Engine dashboard.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  // Onboarding A/B experiment group ("A" | "B"), stamped by the ingest
  // route from the client payload when present. Null = not assigned /
  // pre-onboarding traffic. Resolved per session in src/lib/analytics.
  variant     String?
  // Coarse device class ("mobile" | "tablet" | "desktop"), stamped by the
  // ingest route (client-reported, else derived from the User-Agent).
  // Null on rows written before this column existed ("unknown" in reports).
  device      String?
  // Persistent first-party visitor ID (random UUID, client-generated by
  // src/lib/analytics/visitor-id.ts, persisted in localStorage `we_vid`),
  // stamped by the ingest route when the client sends a well-formed one.
  // Unlike the per-visit sessionId it survives across visits, which is
  // what makes the true return-visit rate measurable. Null on rows
  // written before this column existed and whenever the client sent no
  // (or a malformed) ID.
  visitorId   String?
  // Camera identity for camera_open event rows (Wave 2 item 7), stamped
  // by the analytics ingest route ONLY when the event is camera_open and
  // the client sent a well-formed id. cameraName is the ingest-time label
  // snapshot; the "pick up where you left off" rail re-resolves the live
  // record via /api/cctv?id= at render time and treats that as
  // authoritative. Null on every other row and on ALL pre-instrumentation
  // history — the id was never recorded before, so no backfill exists.
  cameraId    String?
  cameraName  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([event, createdAt])
  @@index([utmCampaign, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, event, createdAt])
}

// ── Competitor comparisons (powers /compare + /compare/[slug]) ─────────
// Researched competitor data. Public pages only render published rows.
model Competitor {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  website       String?
  categories    String[] // e.g. ["osint","conflict-monitoring"]
  tagline       String?
  description   String   @db.Text // direct-answer intro (2-3 sentences)
  features      Json     @default("[]") // [{label, worldEye: "yes"|"partial"|"no"|"unverified", competitor: same, note?}]
  pricing       String?  @db.Text
  whyWorldEye   Json     @default("[]") // string[] — 4-6 verified benefits
  competitorWins String? @db.Text // honest "where the competitor is stronger"
  verdictWorldEye String? @db.Text // "Choose WorldEye if…"
  verdictCompetitor String? @db.Text // "Choose X if…"
  sources       Json     @default("[]") // [{label, url}]
  lastReviewed  DateTime @default(now())
  published     Boolean  @default(false)
  seoTitle      String?
  seoDescription String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published])
}

// ── Newsletter ─────────────────────────────────────────────────────────
// Double opt-in subscribers. Broadcasts go out via /api/admin/newsletter.
model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  verified    Boolean   @default(false)
  verifyToken String?   @unique
  unsubToken  String    @unique @default(cuid())
  source      String?
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?

  @@index([verified])
}

// ── Abandoned checkout tracking ────────────────────────────────────────
// Created on Stripe checkout.session.created, closed on .completed.
// A cron job emails "started" attempts older than 3h with no reminder yet.
model CheckoutAttempt {
  id              String    @id @default(cuid())
  stripeSessionId String    @unique
  email           String?
  plan            String?
  status          String    @default("started") // started | completed | reminded | expired
  remindedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
}

// ── Lifecycle email system (src/lib/lifecycle) ────────────────────────
// One row per lifecycle email actually sent (plus dry-run renders with
// status "dry_run"). This log is the system's memory: the
// (userId, template, contextKey) unique pair is the never-double-send
// rule, and the (userId, createdAt) index backs the 48h marketing cap.
// kind is "marketing" | "transactional" — only marketing rows count
// toward the cap, and only marketing sends honor User.emailOptOut.
model LifecycleEmailLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail String
  template       String   // welcome_discount | interest_followup | retarget_pricing | ...
  contextKey     String   @default("") // e.g. subscription id, attribution id, attempt id
  kind           String   // marketing | transactional
  subject        String
  status         String   @default("sent") // sent | dry_run
  createdAt      DateTime @default(now())

  @@unique([userId, template, contextKey])
  @@index([userId, createdAt])
  @@index([recipientEmail, createdAt])
}

// ── Weekly digest send log ───────────────────────────────────────────
// One row per (subscriber email, issue) for the "In Case You Missed It"
// digest. The digest goes to NewsletterSubscriber rows, most of which
// have no User account — so the send log keys on email, not userId.
// The unique pair is the never-double-send guarantee per issue.
// (Migration 20261022120000_lifecycle_emails — see src/lib/lifecycle.)
model DigestSendLog {
  id       String   @id @default(cuid())
  email    String
  issueKey String
  sentAt   DateTime @default(now())

  @@unique([email, issueKey])
  @@index([issueKey])
}

model Payout {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  amountCents  Int
  currency     String       @default("usd")
  method       String       @default("manual")
  status       PayoutStatus @default(requested)
  providerRef  String?
  decidedBy    String?
  note         String?      @db.Text
  // The status the affiliate was last emailed about. The status email for a
  // transition is sent only when this differs from the current status, so
  // each actual transition emails exactly once (idempotent retries).
  lastEmailedStatus String?

  commissions Commission[]

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  @@index([affiliateProfileId, status])
}

model XPEvent {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  activity String
  xp       Int
  // Anti-abuse: same activity for the same subject can only award once
  idempotencyKey String @unique
  meta           Json?

  createdAt DateTime @default(now())

  @@index([affiliateProfileId, createdAt])
}

enum ChallengeKind {
  daily
  weekly
  monthly
}

model Challenge {
  id          String        @id @default(cuid())
  slug        String        @unique
  kind        ChallengeKind
  title       String
  description String        @db.Text
  xpReward    Int
  metric      String // "visits" | "signups" | "paying_referrals" | "revenue_cents" | "rank_up" | "tutorial"
  target      Int
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean       @default(true)

  progress ChallengeProgress[]

  createdAt DateTime @default(now())

  @@index([kind, active, endsAt])
}

model ChallengeProgress {
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  challengeId        String
  challenge          Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  progress    Int       @default(0)
  completedAt DateTime?

  @@id([affiliateProfileId, challengeId])
  @@index([challengeId])
}

// Singleton row (id = "global") holding admin-tunable program parameters.
model AffiliateSettings {
  id   String @id @default("global")
  data Json

  updatedAt DateTime @updatedAt
}

model AffiliateAuditLog {
  id        String   @id @default(cuid())
  actorUserId String?
  action    String
  targetType String?
  targetId   String?
  details    Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ── Marketing Studio (Phase 1) ─────────────────────────────────────────
// Templates are tokenized SVGs (kind=svg) rendered server-side with the
// affiliate's real link/code injected; creations store params, not files,
// and re-render deterministically (see src/lib/studio/).
model MarketingTemplate {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  category       String
  kind           String
  format         String
  width          Int
  height         Int
  svgBody        String?  @db.Text
  assetUrl       String?
  previewUrl     String?
  editableFields Json
  layers         Json?
  carouselGroup  String?
  slideIndex     Int?
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  tags           String[] @default([])
  publishAt      DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creations      StudioCreation[]
  drops          StudioDrop[]

  @@index([category, active, featured])
  @@index([publishAt])
}

model StudioCreation {
  id                 String   @id @default(cuid())
  affiliateProfileId String
  affiliate          AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  templateId         String?
  template           MarketingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title              String
  kind               String
  campaignKey        String?
  params             Json
  renderHash         String
  paidJobId          String?
  // Phase 3 (Cosmo AI): fulfilled AI results. Text results are stored
  // verbatim; image results are stored as bytes (capped ≈2.5MB at the
  // fulfillment endpoint — no blob storage needed at this scale) and
  // served only to the owning affiliate via an authenticated route.
  resultText         String?  @db.Text
  resultImageBytes   Bytes?
  resultImageMime    String?
  // Phase 5 A/B caption variants: { a: string, b: string } saved by the
  // affiliate, which one they actually posted, and their own free-text
  // result note. Manual honesty — no platform metrics are invented here.
  captionVariants    Json?
  postedVariant      String? // "a" | "b"
  resultNote         String? @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([affiliateProfileId, createdAt])
  @@index([renderHash])
}

// ── Marketing Studio Phase 2: generation credits + jobs ─────────────────
// Credits anchor to CREDIT_USD in src/lib/studio/credits-config.ts and are
// the cost-control layer for paid generation: a GenerationJob is charged
// before rendering (ledger debit), success keeps the debit, failure
// auto-refunds (ledger credit + job status "refunded"). The ledger is the
// audit trail; StudioCreditAccount.balance is its cached sum per profile.
model StudioCreditAccount {
  id        String           @id @default(cuid())
  profileId String           @unique
  profile   AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  balance   Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model StudioCreditLedger {
  id        String           @id @default(cuid())
  profileId String
  profile   AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  jobId     String?
  // External-money idempotency (Phase 3 credit packs): the Stripe
  // checkout session id, namespaced. Unique so a replayed webhook can
  // never double-credit a purchase.
  idempotencyKey String?     @unique
  createdAt DateTime         @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, reason, createdAt])
}

model GenerationJob {
  id          String           @id @default(cuid())
  profileId   String
  profile     AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        String
  status      String           @default("queued")
  creditCost  Int
  params      Json
  error       String?
  // Phase 3 (Cosmo AI): text result of a fulfilled AI job. Image results
  // live on the linked StudioCreation (paidJobId) as bytes — see below.
  resultText  String?          @db.Text
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([profileId, createdAt])
  @@index([status, createdAt])
}

// ── Marketing Studio Phase 4: campaigns, badges, ambassadors, drops ────
// Campaigns are admin-built posting challenges: an affiliate joins, posts
// with the required hashtags/snippet, submits their post URL (trust-based;
// admins spot-check via reviewStatus), and completion pays the campaign's
// XP + credit rewards exactly once (participation.completedAt is the
// idempotency anchor, on top of awardXP keys + a keyed ledger row).
model StudioCampaign {
  id          String   @id @default(cuid())
  name        String
  goal        String
  description String   @db.Text
  startsAt    DateTime
  endsAt      DateTime
  // Posting requirements, shown to affiliates before they join.
  requiredHashtags       String[] @default([])
  requiredCaptionSnippet String?
  // Where affiliates send traffic; the kit appends the standard affiliate
  // UTM parameters (src/lib/studio/campaigns.ts campaignLandingLink).
  landingUrl  String
  xpReward    Int      @default(0)
  creditReward Int     @default(0)
  channels    String[] @default([])
  // Template slugs the campaign kit page renders/downloads (may be empty).
  templateSlugs String[] @default([])
  status      String   @default("draft") // draft | active | ended
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participations StudioCampaignParticipation[]

  @@index([status, startsAt])
}

model StudioCampaignParticipation {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     StudioCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profileId    String
  profile      AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  joinedAt     DateTime @default(now())
  // Affiliate-supplied proof of posting (trust-based; admin spot-checks).
  postUrl      String?
  postedAt     DateTime?
  reviewStatus String   @default("none") // none | verified | flagged
  // Set exactly once, in the same transaction that grants the rewards.
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, profileId])
  @@index([profileId])
}

// Earned Studio/affiliate badges. Rows are inserted by the badge engine
// (src/lib/studio/badges.ts), which evaluates real ledger metrics lazily
// and awards each badge's XP through awardXP with a per-badge key.
model AffiliateBadge {
  id        String   @id @default(cuid())
  profileId String
  profile   AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badgeKey  String
  earnedAt  DateTime @default(now())

  @@unique([profileId, badgeKey])
  @@index([profileId])
}

// Ambassador program applications — same admin-queue shape as
// CreatorApplication, but keyed to the affiliate profile (ambassadors are
// affiliates first). Approval flips AffiliateProfile.isAmbassador.
model AmbassadorApplication {
  id         String    @id @default(cuid())
  profileId  String
  profile    AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId     String
  platform   String // instagram | tiktok | youtube | x | twitch | other
  handle     String
  profileUrl String
  audience   Int // self-reported follower count; verified at admin review
  pitch      String?   @db.Text
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([profileId])
  @@index([status, createdAt])
}

// Daily Content Drop: one admin-published template featured per day.
// The (drop, profile) claim row makes the once-per-day XP bonus
// idempotent; days without a published drop simply have no row.
model StudioDrop {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  templateId String?
  template   MarketingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title      String
  note       String?  @db.Text
  xpBonus    Int      @default(25)
  createdBy  String?
  createdAt  DateTime @default(now())

  claims     StudioDropClaim[]

  @@index([date])
}

model StudioDropClaim {
  id        String   @id @default(cuid())
  dropId    String
  drop      StudioDrop       @relation(fields: [dropId], references: [id], onDelete: Cascade)
  profileId String
  profile   AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dropId, profileId])
  @@index([profileId])
}

// ── Tiered affiliate discount codes: one shared Stripe coupon per percent ─
// Coupons are minted once per discount percent and reused by every
// affiliate's personal promotion code (see src/lib/affiliate/discount.ts).
// ── Marketing Studio 2.0: AI Video Repurposing Machine ──────────────────
// A project is one source video the affiliate owns (or an approved
// library asset) plus its measured analysis. A variation is one creative
// treatment of that source: a persisted composition (segments, captions,
// overlays, filter, branding snapshot) rendered in the browser and
// tracked by its own creative id. Rendering reuses GenerationJob +
// the credits ledger (kind "repurpose_render"); nothing here changes
// attribution or commission rules.
model StudioProject {
  id             String   @id @default(cuid())
  profileId      String
  profile        AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  // upload (Vercel Blob) | library (approved studio footage) |
  // creation (the affiliate's own StudioCreation) | url (direct media URL)
  sourceKind     String
  sourceRef      String?
  sourceName     String?
  durationSec    Float?
  width          Int?
  height         Int?
  // The affiliate confirmed they own or have permission to edit and
  // distribute the source. Must be true before any variation renders.
  ownershipConfirmed Boolean @default(false)
  // Measured client-side analysis (metadata, scene cuts, audio energy).
  // Only signals actually measured are stored; the UI shows nothing else.
  analysis       Json?
  transcript     String?  @db.Text
  // One AffiliateTrackingLink per project (the 25-link cap is shared);
  // per-variation attribution rides utm_content=<creativeId>.
  trackingLinkId String?
  status         String   @default("draft") // draft | ready | archived
  folder         String   @default("drafts") // drafts | published | scheduled | high_performing | templates | uploads | graphics | archived
  brandVoice     String?  // professional | casual | exciting | educational | cinematic | technical | minimalist
  campaignTag    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variations     StudioVariation[]
  posts          StudioPost[]

  @@index([profileId, createdAt])
  @@index([profileId, folder])
}

model StudioVariation {
  id            String   @id @default(cuid())
  projectId     String
  project       StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creativeId    String   @unique
  direction     String   // viral_curiosity | educational | cinematic | fast_paced | product_demo | news_context | storytelling | problem_solution | testimonial | minimalist
  title         String
  aspect        String   @default("9:16") // 9:16 | 1:1 | 4:5 | 16:9
  // { segments, captions, overlays, filter, speed, branding } — the full
  // editable composition; the editor and renderer both read this shape
  // (src/lib/studio/repurpose.ts).
  composition   Json
  hookText      String?
  captionText   String?  @db.Text
  // Branding snapshot at generation time. If the profile's current code
  // differs, the editor warns the draft carries an outdated code.
  codeSnapshot  String?
  status        String   @default("draft") // draft | rendered | published | archived
  renderJobId   String?
  favorite      Boolean  @default(false)
  postedPlatform String?
  postedUrl     String?
  postedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts         StudioPost[]

  @@index([projectId, createdAt])
}

// ── Marketing Studio 2.0: content calendar / publishing records ────────
// One planned or completed post for a variation (or a whole project).
// method "reminder" = the affiliate publishes manually (the only method
// until a platform API is genuinely approved); "api" is reserved for
// approved direct integrations. Reminder delivery reuses
// AffiliateNotification + the lifecycle email log.
model StudioPost {
  id            String   @id @default(cuid())
  profileId     String
  profile       AffiliateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId     String?
  project       StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variationId   String?
  variation     StudioVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  platform      String   // instagram | facebook | tiktok | youtube | snapchat | x | threads | linkedin | pinterest
  caption       String?  @db.Text
  affiliateLink String?
  scheduledAt   DateTime
  timezone      String   @default("UTC") // IANA tz the affiliate picked
  method        String   @default("reminder") // reminder | api
  status        String   @default("scheduled") // draft | ready | scheduled | reminder_due | publishing | published | failed | cancelled
  reminderOffsetsMin Int[] @default([]) // minutes before scheduledAt
  remindedFor   Int[]    @default([]) // offsets already delivered (idempotency)
  publishedUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId, scheduledAt])
  @@index([status, scheduledAt])
}

model AffiliateDiscountCoupon {
  pct            Int    @id
  stripeCouponId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Phase 1 camera recording: user-saved cameras + clip metadata ─────────
// Clip video blobs live in the browser's IndexedDB (device-local); only
// metadata is stored here. No large files in the database.
model SavedCamera {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  group      String   @default("Ungrouped")
  // Snapshot of the resolved camera object (stream_url, feed_url, lat/lng…)
  cameraData Json
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, group])
}

// ── Powder Pass: favourite resorts (follows) ──────────────────────
// One row per (user, resort) the member follows from a resort page;
// the /ski-webcams/my dashboard and the ski email features read this
// list. resortSlug is validated against SKI_RESORTS in lib/ski/follows
// before a row is written — the DB stores the slug only.
model SkiResortFollow {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resortSlug String
  createdAt  DateTime @default(now())

  @@unique([userId, resortSlug])
  @@index([userId])
}

// ── Powder Pass: ski email send log ───────────────────────────────
// One row per (user, kind, dedupe key) for the ski email runners:
// dawn patrol uses kind 'dawn' with the UTC run date as the key; the
// Thursday powder digest uses kind 'digest' with the ISO week. The
// unique triple is the never-send-twice guarantee — runners check
// before sending and write only after a successful send.
model SkiEmailSendLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String
  sentAt    DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([userId])
}

// Powder Pass pass-value tracker (feature #8): the member's own pass
// season — what THEY paid and, optionally, their own typical day
// price — plus the days they log against it. User-entered data only;
// every displayed figure is computed from these rows alone.
model SkiPassSeason {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  costCents     Int
  dayPriceCents Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SkiPassDay {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skiedOn    DateTime
  resortSlug String?
  createdAt  DateTime @default(now())

  @@unique([userId, skiedOn, resortSlug])
  @@index([userId])
}

model ClipMeta {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedCameraId String?
  cameraName    String
  startedAt     DateTime
  durationSec   Int
  sizeBytes     Int
  mimeType      String   @default("video/webm")
  createdAt     DateTime @default(now())
  shares        ClipShare[]

  @@index([userId, createdAt])
}

// ── Public clip shares ─────────────────────────────────────────────────
// A recording lives in the owner's browser (IndexedDB) until they share
// it: sharing uploads the file to hosted blob storage and creates one of
// these rows. The watch page (/watch/[slug]) is public by design; the
// slug is the only credential. Revoking stamps revokedAt AND deletes the
// stored file, so a revoked link is gone, not just hidden. refCode is
// the sharer's universal share code (lib/share/identity) captured at
// creation time — watch-page visits drop the same we_ref attribution
// cookie a /ref/<code> visit drops.
model ClipShare {
  id          String    @id @default(cuid())
  slug        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId      String
  clip        ClipMeta  @relation(fields: [clipId], references: [id], onDelete: Cascade)
  title       String
  blobUrl     String
  posterUrl   String?
  mimeType    String    @default("video/webm")
  sizeBytes   Int
  durationSec Int
  cameraName  String
  refCode     String?
  // public = indexable/linkable normally; unlisted = reachable only by
  // slug and excluded from indexing/public metadata surfaces.
  visibility  String    @default("public")
  views       Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

// ── Enterprise camera feed ─────────────────────────────────────────────
// Enterprise subscribers build camera collections and publish them three
// ways off one payload: an embeddable player, a private token feed URL,
// and (optionally) API keys. Secrets are stored ONLY as SHA-256 hashes —
// a feed token is shown once at generation (regenerating is revocation),
// an API key once at creation. Payloads are rights-filtered at read time
// (src/lib/enterprise/rights.ts): only redistribution-cleared sources ship.

model CameraCollection {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Team Access: when set, the collection is shared with this organization
  // (members read it per their role). Null = personal collection.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  // SHA-256 hex of the current feed token; null = feed link not generated
  // (or revoked). The plaintext token exists only in the customer's hands.
  feedTokenHash String?  @unique
  feedHits      Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         CameraCollectionItem[]

  @@index([userId])
  @@index([organizationId])
}

model CameraCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   CameraCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Catalogue camera id (src/app/api/cctv records). Resolution and
  // rights filtering happen at read time against the live catalogue.
  cameraId     String
  createdAt    DateTime @default(now())

  @@unique([collectionId, cameraId])
  @@index([collectionId])
}

model EnterpriseApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  // Display prefix ("wek_" + first 8 key chars) — identifies the key in
  // lists without revealing anything usable.
  keyPrefix  String
  // SHA-256 hex of the full key; the plaintext is shown once at creation.
  keyHash    String    @unique
  hits       Int       @default(0)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  // Which door the key belongs to: "enterprise" (the collections API —
  // every pre-2026-10-30 key) or "public" (the self-serve developer API,
  // /api/v1 + /api/v1/mcp, created from Account Settings). The doors do
  // not accept each other's keys.
  scope      String    @default("enterprise")
  // Public-door daily quota window: the UTC day the counter belongs to
  // and how many requests it has counted. Null until first public use.
  rateWindowStart DateTime?
  rateWindowCount Int       @default(0)

  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ── VIP camera alerts ────────────────────────────────────────────────
// A VIP Pro member watches up to 10 cameras with a plain-language
// condition ("snow on the road"). A cron checker (every ~15 min) has
// an AI look at the camera's latest still and, when the condition
// starts matching, notifies by email + an in-app AlertEvent. Rules
// pause (never delete) when the owner's VIP lapses.

model AlertRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Catalogue camera id (src/app/api/cctv records) + the name as it
  // read when the rule was made, so lists stay legible if the
  // catalogue renames it later.
  cameraId      String
  cameraName    String
  // The member's own words, e.g. "snow on the road".
  condition     String

  emailEnabled  Boolean  @default(true)
  inAppEnabled  Boolean  @default(true)
  active        Boolean  @default(true)

  // Last completed check: "matches" | "clear" | "unknown" (unknown =
  // no still could be fetched or read — it never alerts).
  lastVerdict   String   @default("unknown")
  // True once the current matching episode has been notified, so a
  // condition that keeps matching doesn't re-alert every check.
  matchNotified Boolean  @default(false)
  lastCheckedAt DateTime?
  lastAlertedAt DateTime?

  events        AlertEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([active, lastCheckedAt])
}

model AlertEvent {
  id          String    @id @default(cuid())
  ruleId      String
  rule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Denormalised owner: the inbox lists and prunes by user without a join.
  userId      String

  // Always "matches" today — an event is a notification, not a check log.
  verdict     String    @default("matches")
  // The AI's own words about the frame it saw (an observation, not a fact claim).
  observation String
  // When the checked still was captured (frame route's X-Frame-At).
  frameAt     DateTime?
  // The exact still the checker saw, 768px JPEG, base64. Lets the alert
  // show its own photo instead of whatever the camera shows later.
  imageJpeg   String?   @db.Text
  emailSent   Boolean   @default(false)
  pushSent    Boolean   @default(false)
  readAt      DateTime?

  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([ruleId])
}

// ── Team Access & Collaboration ────────────────────────────────────────
// A paying subscriber (the owner) runs ONE Organization, buys extra seats
// as a graduated-tier ITEM on their existing Stripe subscription, and
// invites members who inherit the owner's plan tier while the owner's
// subscription is active. Seat capacity is enforced transactionally:
// active members + pending invitations never exceed purchasedSeats.

model Organization {
  id          String @id @default(cuid())
  name        String
  // One organization per owner (the owner's own subscription funds it).
  ownerId     String @unique
  owner       User   @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  logoUrl     String?
  description String?
  // Role new invitations get when the inviter doesn't choose: member|admin.
  defaultInviteRole  String  @default("member")
  allowMemberInvites Boolean @default(false)
  // Platform admin kill-switch (abuse) — separate from billing state.
  suspended   Boolean @default(false)

  // Seat billing state — reconciled ONLY by the Stripe webhook from the
  // owner's subscription items (never written by request handlers except
  // for the pending-downgrade bookkeeping below).
  stripeSeatItemId  String?
  stripeSeatPriceId String?
  purchasedSeats    Int     @default(0)
  // Scheduled seat reduction: applied to Stripe at pendingSeatsAt (the
  // current period end) by the team-seats cron; capacity stays at
  // purchasedSeats until then.
  pendingSeats      Int?
  pendingSeatsAt    DateTime?

  members     OrganizationMember[]
  invitations TeamInvitation[]
  activity    TeamActivityLog[]
  collections CameraCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // owner | admin | member
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model TeamInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Normalized (lowercased, trimmed) invited address.
  email          String
  role           String       @default("member")
  // SHA-256 hex of the acceptance token — the plaintext only ever exists
  // in the emailed link.
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  // pending | accepted | revoked | expired
  status         String       @default("pending")
  expiresAt      DateTime
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([email])
}

model TeamActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  // invitation_created | invitation_accepted | member_removed | role_changed
  // | seats_purchased | seats_downgraded | settings_changed | ...
  type           String
  detail         Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// Singleton (id = "default") admin-editable pricing knobs. `tiers` shape:
// { weekly: [{upTo: number|null, unitCents}], monthly: [...], annual: [...] }
// `seatPriceIds` maps cycle → Stripe price id whose graduated tiers match
// `tiers` at the time the price was created; when an admin changes tiers,
// new Stripe prices are created and stored here, and only NEW seat items
// use them (existing seat items keep their Stripe price).
model TeamPricingConfig {
  id               String   @id @default("default")
  maxSeats         Int      @default(50)
  inviteExpiryDays Int      @default(7)
  tiers            Json
  seatPriceIds     Json
  updatedAt        DateTime @updatedAt
}

// Org-wide concurrent recording pool: a lease per (org, user, camera),
// heartbeat-refreshed via expiresAt. Acquire is transactional so the
// owner's recording cap is shared across the whole organization and can
// never be raced past.
model TeamRecordingLease {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  cameraKey      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId, cameraKey])
  @@index([organizationId, expiresAt])
}

// ── Contact form inbox ─────────────────────────────────────────────────
// Submissions from the public /contact form (POST /api/contact). Read and
// managed by admins in /admin/contact. Status flow mirrors the other
// admin-reviewed queues: "unread" → "read" → "resolved" (reopenable to
// "unread"). Deliberately standalone: the sender is usually signed out,
// so there is no user relation — name/email are what they typed.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  // One of the values in CONTACT_TOPICS (src/lib/contact.ts).
  topic     String    @default("general")
  message   String
  status    String    @default("unread")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

// ── Partnership applications (public /partners) ────────────────────────
// Strategic-partnership proposals from the /partners application form,
// managed by admins in /admin/partnerships (status flow, notes and a
// follow-up date — the CRM tracks; it never sends). Type values live in
// PARTNERSHIP_TYPES and statuses in PARTNERSHIP_STATUSES
// (src/lib/partners.ts). Deliberately standalone like ContactMessage:
// applicants are usually signed out, so there is no user relation.
model PartnershipApplication {
  id             String    @id @default(cuid())
  name           String
  email          String
  company        String
  website        String
  // One of the values in PARTNERSHIP_TYPES (src/lib/partners.ts).
  type           String
  audienceSize   String?
  resources      String
  seeking        String
  proposal       String
  // Title of the opportunities-directory entry the applicant clicked, if any.
  opportunity    String?
  // One of PARTNERSHIP_STATUSES (src/lib/partners.ts).
  status         String    @default("new")
  adminNotes     String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

// ── Camera requests (demand capture from search empty states) ─────────
// A visitor searched the globe or the camera directory for a place,
// found nothing, and asked us to look for a feed there ("Request this
// camera"). The DEMAND side of coverage — the supply side is
// CameraSubmission below, where a visitor hands us a specific feed URL.
// A request carries no URL and promises nothing; rows are read by
// admins in /admin/camera-requests as the expansion demand signal.
model CameraRequest {
  id        String @id @default(cuid())
  // The exact failed search text, when the surface has one.
  query     String?
  // The place the visitor wants a camera for.
  placeText String
  // Optional notify-me address — never required.
  email     String?
  // Signed-in user who asked, when there is one (set server-side).
  userId    String?
  // Analytics session id (we_sid), when available.
  sessionId String?
  // One of CAMERA_REQUEST_STATUSES (src/lib/camera-requests).
  status    String @default("new")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([placeText])
}

// ── Submit-a-camera intake (public /submit-camera) ─────────────────────
// Anyone can send us a camera: operators list their own feed, everyone
// else suggests a public one. Submissions land here for human review in
// /admin/camera-submissions. Approval means "cleared for import" only —
// the catalogue import itself stays a separate ops step, so an approved
// row is NOT a promise the camera is live on the map.
model CameraSubmission {
  id             String @id @default(cuid())
  // "own" = submitter operates the camera; "suggest" = a public feed
  // they found. The declaration text differs per kind (src/lib/camera-submissions).
  kind           String
  cameraName     String
  url            String // stream or page URL; http/https + SSRF host-checked at intake
  category       String // one of CAMERA_SUBMISSION_CATEGORIES (src/lib/camera-submissions)
  city           String
  country        String
  lat            Float?
  lng            Float?
  notes          String?
  submitterName  String
  submitterEmail String
  declaration    Boolean // the ownership/permission declaration was affirmed

  status           String    @default("pending") // pending | approved | rejected
  probeStatus      String    @default("unknown") // reachable | unreachable | unknown
  probeDetail      String?
  probedAt         DateTime?
  reviewerNotes    String?
  reviewedBy       String?
  reviewedAt       DateTime?
  receiptEmailedAt  DateTime?
  decisionEmailedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([submitterEmail])
  @@index([createdAt])
}

// ── VIP Pro features (event alerts, personal brief, saved views) ────────
// Watched places are the shared substrate: a VIP member names places
// (lat/lng + radius) once, and event alerts (quakes near a place, ISS
// passes over it) and the personal brief read the same list.

model VipPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  lat       Float
  lng       Float
  // Watch radius for "near this place" checks (quakes, fires in briefs).
  radiusKm  Int      @default(250)

  eventAlertRules EventAlertRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Event alerts: the camera-alerts pattern (AlertRule/AlertEvent) extended
// beyond cameras. A rule watches the planet, not a camera:
//   kind "quake"  — USGS quakes at/above config.minMag, worldwide or
//                   within the watched place's radius when placeId set.
//   kind "launch" — Launch Library 2 liftoffs; fires once per lead
//                   window in config.leadHours (e.g. 24h and 1h).
//   kind "iss"    — visible ISS passes over the watched place (placeId
//                   required), computed from the CelesTrak TLE with the
//                   in-repo SGP4 propagator; config.minElevationDeg.
// Rules pause (never delete) when the owner's VIP lapses — the checker
// resolves the owner's tier at check time, exactly like camera alerts.

model EventAlertRule {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind          String    // "quake" | "launch" | "iss"
  placeId       String?
  place         VipPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)
  // Kind-specific thresholds, validated by lib/vip/events/logic:
  //   quake:  { minMag: number }
  //   launch: { leadHours: number[] }
  //   iss:    { minElevationDeg: number, leadHours: number }
  config        Json

  emailEnabled  Boolean   @default(true)
  inAppEnabled  Boolean   @default(true)
  active        Boolean   @default(true)
  lastCheckedAt DateTime?

  events        EventAlertEvent[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([active, kind])
}

model EventAlertEvent {
  id          String    @id @default(cuid())
  ruleId      String
  rule        EventAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Denormalised owner, same as AlertEvent: inboxes list by user.
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind        String    // mirrors the rule's kind
  title       String
  body        String
  // Structured payload for the inbox/brief (quake mag/place, launch id,
  // pass times) — display data only, never a second source of truth.
  data        Json?
  // Stable identity of the underlying event for this rule (USGS quake
  // id, LL2 launch id + window, ISS pass start). The unique pair with
  // ruleId is what makes re-checks idempotent.
  dedupeKey   String
  emailSent   Boolean   @default(false)
  pushSent    Boolean   @default(false)
  readAt      DateTime?

  createdAt   DateTime  @default(now())

  @@unique([ruleId, dedupeKey])
  @@index([userId, createdAt])
  @@index([ruleId])
}

// Saved globe views: a named layer stack (the globe's own `layers` URL
// keys) plus an optional camera deep link — restored in one click via
// the globe's existing ?layers= / ?camera= URL contract. The globe has
// no camera-position URL param, so a view is layers (+ camera), never
// a fabricated lat/lng the globe could not honour.

model SavedView {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  // Comma-joined layer keys, validated against the globe's layer set.
  layers     String
  cameraId   String?
  cameraName String?
  sortOrder  Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Personal brief preferences: the /vip/brief page itself is on-demand;
// this row only carries the daily email digest opt-in + send watermark.

model VipBriefPref {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled Boolean   @default(false)
  lastSentAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── WorldEye Fraud Radar: Data Source Registry (spec §5) ────────────
// Additive-only. The registry is the platform's memory of what data it
// holds, where it came from, and how fresh it is — bulk government data
// itself lives in versioned Parquet artifacts (AUDIT §15), never in
// these tables. Seeded from src/lib/fraud-radar/sources.ts.

model FrDataSource {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  engine            String   // healthcare | grants | contracts | cross-cutting
  officialUrl       String
  accessUrl         String
  accessType        String   // public_download | public_api | public_extract | api_key_required
  apiKeyRequirement String   // "none" or a plain-language statement
  license           String
  commercialUse     String
  dataFields        String[]
  coverageStart     String?  // "YYYY-MM" when bounded
  coverageEnd       String?
  limitations       String
  cadence           String
  // not_started | ok | degraded | error | pending_credentials
  status            String   @default("not_started")
  notes             String   @default("")
  lastPublishedAt   DateTime?
  lastImportedAt    DateTime?
  lastVerifiedAt    DateTime?
  sourceVersion     String?
  completeness      String?
  lastError         String?

  importRuns        FrImportRun[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([engine])
  @@index([status])
}

// One execution of a source's batch pipeline (AUDIT §8/§15). Row and
// byte counts are BigInt: the Medicaid source alone is ~238M rows.
model FrImportRun {
  id               String       @id @default(cuid())
  sourceId         String
  source           FrDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  datasetVersion   String?      // e.g. the extract file's date/name
  // running | succeeded | failed | quarantined
  status           String       @default("running")
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  rowsProcessed    BigInt?
  rowsValid        BigInt?
  rowsQuarantined  BigInt?
  artifactPath     String?      // object-storage key / URL of the published artifact
  artifactSha256   String?
  manifest         Json?        // the pipeline manifest (§15a) as published
  error            String?

  createdAt        DateTime     @default(now())

  @@index([sourceId, startedAt])
  @@index([status])
}

// ── Fraud Radar Phase 2: Neon summary grain (AUDIT §15a) ───────────
// Pre-aggregated, app-readable summaries published by the batch
// pipeline — NOT bulk data. The provider-grain artifacts (search
// stubs, profiles, monthly series) live in versioned object storage;
// Neon holds only these small code/national grains plus the registry.
// Monetary columns exist in both labelled treatments (all reported
// cells / excluding the 62 flagged >$1B outlier cells); every row is
// stamped with its dataset version for provenance.

model FrHcpcsSummary {
  id                        String   @id @default(cuid())
  datasetVersion            String   // e.g. "2026-02-09" (Medicaid version)
  hcpcsCode                 String
  reportedCells             BigInt
  totalClaimLines           BigInt
  totalPatientsReported     BigInt   // reported-patient volume, NOT unique beneficiaries
  totalPaidAllCellsUsd      Decimal  @db.Decimal(18, 2)
  outlierCells              BigInt
  outlierPaidUsd            Decimal  @db.Decimal(18, 2)
  totalPaidExclOutliersUsd  Decimal  @db.Decimal(18, 2)
  // Nullable: the source leaves the distinct count NULL when a code's
  // reported cells never carry that role's NPI (1,373 / 1,530 of
  // 12,263 codes in the 2026-02-09 file) — absent, never a fake 0.
  distinctBillingNpis       Int?
  distinctServicingNpis     Int?
  firstClaimMonth           DateTime? @db.Date
  lastClaimMonth            DateTime? @db.Date
  activeMonths              Int

  createdAt                 DateTime @default(now())

  @@unique([datasetVersion, hcpcsCode])
  @@index([datasetVersion])
}

model FrMonthlyNationalSummary {
  id                        String   @id @default(cuid())
  datasetVersion            String
  claimMonth                DateTime @db.Date
  reportedCells             BigInt
  totalClaimLines           BigInt
  totalPatientsReported     BigInt
  totalPaidAllCellsUsd      Decimal  @db.Decimal(18, 2)
  outlierCells              BigInt
  outlierPaidUsd            Decimal  @db.Decimal(18, 2)
  totalPaidExclOutliersUsd  Decimal  @db.Decimal(18, 2)
  distinctBillingNpis       Int
  distinctServicingNpis     Int
  distinctHcpcsCodes        Int

  createdAt                 DateTime @default(now())

  @@unique([datasetVersion, claimMonth])
  @@index([datasetVersion])
}

// ── Fraud Radar Phase 3: care programs Neon grain (AUDIT §15a) ─────
// Medicare Physician & Other Practitioners PUF (fee-for-service
// Part B): HCPCS × year and yearly national summaries. Every amount
// is DERIVED from the source's published averages (services ×
// average) — the column names carry "Derived" so no surface can
// mistake them for claim-level totals. benesReported is a reported
// volume summed over published rows, never a unique-beneficiary
// count. CMS suppression means absent rows are missing data, not 0.
// Care Compare directories (hospice / home health) keyed by CMS
// certification number (CCN); the home-health quality star is CMS's
// own published rating, stored verbatim with its footnote.

model FrMedicareHcpcsSummary {
  id                 String   @id @default(cuid())
  datasetVersion     String   // "2022-2024" (PUF calendar-year span)
  hcpcsCode          String
  hcpcsDesc          String?
  dataYear           Int
  distinctProviders  Int
  totalServices      Decimal  @db.Decimal(20, 2)
  benesReported      BigInt
  pymtDerivedUsd     Decimal  @db.Decimal(18, 2)
  allowedDerivedUsd  Decimal  @db.Decimal(18, 2)
  stdzdDerivedUsd    Decimal  @db.Decimal(18, 2)
  submittedDerivedUsd Decimal @db.Decimal(18, 2)
  sourceRows         BigInt

  createdAt          DateTime @default(now())

  @@unique([datasetVersion, hcpcsCode, dataYear])
  @@index([datasetVersion, dataYear])
}

model FrMedicareYearlySummary {
  id                 String   @id @default(cuid())
  datasetVersion     String
  dataYear           Int
  distinctProviders  Int
  distinctHcpcs      Int
  totalServices      Decimal  @db.Decimal(20, 2)
  benesReported      BigInt
  pymtDerivedUsd     Decimal  @db.Decimal(18, 2)
  allowedDerivedUsd  Decimal  @db.Decimal(18, 2)
  stdzdDerivedUsd    Decimal  @db.Decimal(18, 2)
  submittedDerivedUsd Decimal @db.Decimal(18, 2)
  sourceRows         BigInt

  createdAt          DateTime @default(now())

  @@unique([datasetVersion, dataYear])
  @@index([datasetVersion])
}

model FrHospiceProvider {
  id                String   @id @default(cuid())
  datasetVersion    String   // "2026-10-refresh" (Care Compare refresh)
  ccn               String   // CMS certification number
  facilityName      String
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  zipCode           String?
  county            String?
  phone             String?
  cmsRegion         String?
  ownershipType     String?
  certificationDate DateTime? @db.Date

  createdAt         DateTime @default(now())

  @@unique([datasetVersion, ccn])
  @@index([datasetVersion, state])
}

model FrHomeHealthAgency {
  id                        String   @id @default(cuid())
  datasetVersion            String   // "2026-10-refresh" (Care Compare refresh)
  ccn                       String
  providerName              String
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  phone                     String?
  ownershipType             String?
  certificationDate         DateTime? @db.Date
  // CMS's own published quality-of-care star rating (1–5), stored
  // verbatim — never a Fraud Radar score. Null when CMS publishes
  // none for the agency.
  qualityStarRating         Decimal? @db.Decimal(3, 1)
  qualityStarFootnote       String?
  offersNursing             Boolean?
  offersPhysicalTherapy     Boolean?
  offersOccupationalTherapy Boolean?
  offersSpeechPathology     Boolean?
  offersMedicalSocial       Boolean?
  offersHomeHealthAide      Boolean?

  createdAt                 DateTime @default(now())

  @@unique([datasetVersion, ccn])
  @@index([datasetVersion, state])
}

// ── Transit route email alerts (2026-10-29) ────────────────────────
// Email-only subscriptions to one route's service alerts (MBTA v3 is
// the upstream). Deliberately NOT tied to User: a visitor with no
// account gets the first 5 alert digest emails free, and the runner
// lifts the cap the moment a User row exists for the address. The
// cap/dedupe rules live in src/lib/transit/alertSubscriptions.
model TransitAlertSubscription {
  id        String @id @default(cuid())
  email     String // normalized lowercase by the shared email validator
  agency    String // agency id, e.g. "mbta"
  routeId   String // upstream route id, e.g. MBTA "Orange"
  routeSlug String // site route-page slug, e.g. "orange-orange-line"
  routeName String // display name used in email copy, e.g. "Orange Line"
  status    String @default("active") // active | unsubscribed
  // Digest emails sent while the address had no account — the
  // free-tier counter (cap = FREE_ALERT_EMAIL_LIMIT in the lib).
  alertsSent            Int       @default(0)
  conversionEmailSentAt DateTime?
  unsubToken            String    @unique @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sends TransitAlertSend[]

  @@unique([email, agency, routeId])
  @@index([agency, routeId, status])
}

// One row per alert version emailed — the dedupe ledger. An alert is
// re-emailed only when the upstream record's updated_at changes.
model TransitAlertSend {
  id             String                   @id @default(cuid())
  subscriptionId String
  subscription   TransitAlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  alertId        String // upstream alert id
  alertUpdatedAt DateTime // upstream updated_at at send time
  sentAt         DateTime @default(now())

  @@unique([subscriptionId, alertId, alertUpdatedAt])
  @@index([subscriptionId])
}

// ── Ski trip booking reminders (2026-10-30) ────────────────────────
// A signed-in user picks a resort from the live ski directory, trip
// dates and an email; the cron runner emails two book-ahead nudges
// (T-45d "book flights + lodging", T-14d final nudge). Reminders
// only — no booking engine, no affiliate links, no prices. The
// date/dedupe rules live in src/lib/ski/trip-reminders; dedupe is
// the sent45At/sent14At stamps (an email goes out at most once).
model SkiTripReminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String // normalized lowercase by the shared email validator
  resortSlug String // ski directory slug, e.g. "park-city"
  resortName String // display name used in email copy, e.g. "Park City"
  tripStart  DateTime // arrival date (UTC midnight of the chosen day)
  tripEnd    DateTime? // optional departure date
  status     String    @default("active") // active | cancelled
  sent45At   DateTime?
  sent14At   DateTime?
  unsubToken String    @unique @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, resortSlug, tripStart])
  @@index([status, tripStart])
}

// Powder #5 (rescoped): one row per resort per captured snow-stake
// night. frames = [{ t, url, sig }] chronological, stored by
// /api/cron/ski-stake-capture from the operator's own stake still.
model SkiStakeNight {
  id         String   @id @default(cuid())
  resortSlug String
  nightKey   String // Denver date the night started, YYYY-MM-DD
  frames     Json // [{ t, url, sig }] chronological
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([resortSlug, nightKey])
  @@index([nightKey])
}

// ── Fraud Radar Phase 4: grants Neon grain (AUDIT §15a) ───────────
// USAspending assistance (generation 2026-10-06, globally deduped
// to one row per award) at the yearly / ALN / agency grains, plus
// the FAC single-audit yearly grain (vintage 2026-10-31_ay2026 —
// the FAC datasetVersion is a column value, not separate tables).
// USAspending amounts are AWARD-CUMULATIVE snapshot totals with
// source names kept; ALN/agency fiscal years are ATTRIBUTED (the
// archive fiscal year of each award's winning snapshot), never a
// re-dating of the money. FAC expended is auditee-reported;
// questioned costs exist only as flag counts (the source publishes
// no amounts); is_public=false records are withheld (count only).

model FrGrantsYearlySummary {
  id                          String   @id @default(cuid())
  datasetVersion              String   // "2026-10-06" (USAspending generation)
  fiscalYear                  Int      // attributed fiscal year
  awards                      BigInt
  distinctRecipients          Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)
  outlayAwardCumulativeUsd    Decimal  @db.Decimal(24, 2)
  subawardsCount              BigInt
  subawardAmountUsd           Decimal  @db.Decimal(24, 2)

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, fiscalYear])
  @@index([datasetVersion])
}

model FrGrantsAlnSummary {
  id                          String   @id @default(cuid())
  datasetVersion              String
  aln                         String   // assistance listing (CFDA) number
  alnTitle                    String?
  attributedFiscalYear        Int
  awards                      BigInt
  distinctRecipients          Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, aln, attributedFiscalYear])
  @@index([datasetVersion, attributedFiscalYear])
}

model FrGrantsAgencySummary {
  id                          String   @id @default(cuid())
  datasetVersion              String
  agency                      String   // awarding agency name, as published
  attributedFiscalYear        Int
  awards                      BigInt
  distinctRecipients          Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, agency, attributedFiscalYear])
  @@index([datasetVersion, attributedFiscalYear])
}

model FrFacYearlySummary {
  id                      String   @id @default(cuid())
  datasetVersion          String   // "2026-10-31_ay2026" (FAC vintage)
  auditYear               Int
  reports                 BigInt
  totalExpendedUsd        Decimal  @db.Decimal(24, 2) // auditee-reported
  findingsCount           BigInt
  repeatFindingsCount     BigInt
  questionedCostFlagCount BigInt   // flags only — no amounts exist
  distinctAuditees        Int

  createdAt               DateTime @default(now())

  @@unique([datasetVersion, auditYear])
  @@index([datasetVersion])
}

// ── Fraud Radar Phase 5: contracts Neon grain (AUDIT §15a) ───────
// USAspending contracts (generation 2026-10-06, globally deduped
// to one row per contract award) at the yearly / NAICS / PSC /
// agency grains — the FrGrants* shapes mirrored 1:1 with
// grants→contracts renames. Amounts are AWARD-CUMULATIVE snapshot
// totals (winning snapshot row only); NAICS/PSC/agency fiscal
// years are ATTRIBUTED (the archive fiscal year of each award's
// winning snapshot). Ceiling / potential-value fields are never
// modelled here — ceilings are not obligations. Outlay columns
// are nullable: an award whose winning snapshot reports no
// outlay contributes absence (null), never a fabricated zero.
// FAC does NOT cover contracts: there is no FAC grain in Phase 5.

model FrContractsYearlySummary {
  id                          String   @id @default(cuid())
  datasetVersion              String   // "2026-10-06" (USAspending generation)
  fiscalYear                  Int      // attributed fiscal year
  awards                      BigInt
  distinctVendors             Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)
  outlayAwardCumulativeUsd    Decimal? @db.Decimal(24, 2)
  transactions                BigInt   // transactions in window (attributed awards)
  modifications               BigInt   // modification transactions in window

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, fiscalYear])
  @@index([datasetVersion])
}

model FrContractsNaicsSummary {
  id                          String   @id @default(cuid())
  datasetVersion              String
  // Nullable (P5-A2): the publisher's contracts-neon.json carries
  // one null-code row per attributed fiscal year — awards whose
  // winning snapshot reports no NAICS code. Absence stays null;
  // no sentinel code is fabricated, so every grain reconciles.
  naics                       String?
  naicsDescription            String?
  attributedFiscalYear        Int
  awards                      BigInt
  distinctVendors             Int
  distinctPscCodes            Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)
  outlayAwardCumulativeUsd    Decimal? @db.Decimal(24, 2)
  transactionsInWindow        BigInt
  modificationsInWindow       BigInt

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, naics, attributedFiscalYear])
  @@index([datasetVersion, attributedFiscalYear])
}

model FrContractsPscSummary {
  id                          String   @id @default(cuid())
  datasetVersion              String
  // Nullable (P5-A2): same published null-code row as NAICS —
  // awards whose winning snapshot reports no PSC code.
  psc                         String?
  pscDescription              String?
  attributedFiscalYear        Int
  awards                      BigInt
  distinctVendors             Int
  distinctNaicsCodes          Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)
  outlayAwardCumulativeUsd    Decimal? @db.Decimal(24, 2)
  transactionsInWindow        BigInt
  modificationsInWindow       BigInt

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, psc, attributedFiscalYear])
  @@index([datasetVersion, attributedFiscalYear])
}

model FrContractsAgencySummary {
  id                          String   @id @default(cuid())
  datasetVersion              String
  agency                      String   // awarding agency name, as published
  agencyCode                  String?  // toptier agency code, as published
  attributedFiscalYear        Int
  awards                      BigInt
  distinctVendors             Int
  obligatedAwardCumulativeUsd Decimal  @db.Decimal(24, 2)
  outlayAwardCumulativeUsd    Decimal? @db.Decimal(24, 2)
  transactionsInWindow        BigInt
  modificationsInWindow       BigInt

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, agency, attributedFiscalYear])
  @@index([datasetVersion, attributedFiscalYear])
}

// ── Fraud Radar Phase 6: statistical intelligence Neon grain ──────
// Summary grain ONLY (PHASE6 §6.5 Neon decision): one row per
// (signals version × rule) plus one row per (dataset × quality
// run). The ~20M evaluated signal rows and the peer-group table
// deliberately do NOT live in Neon — entity reads are bucket-file
// reads via signals-data.ts, and peer groups are read from the
// artifacts where a profile needs them (no FrPeerGroupSummary).
// Signals are research leads only — never declarations about an
// entity, never a grade; there is no composite standing anywhere
// in this grain. A rule whose form has no by-construction
// expectation (own-history / count forms) carries NULL
// expectedByConstruction and NULL noiseCaution — not applicable,
// never a fabricated zero/false. The contracts engine has NO rows
// while its state is not_computed_input_not_published: the absence
// of rows is the pending state, never a count of zero.

model FrSignalRuleSummary {
  id                          String   @id @default(cuid())
  // Composite signals version, e.g.
  // "2026-02-09+2022-2024+2026-10-06" (input aggregate versions
  // joined, PHASE6 §1.3) — a column value, as in prior phases.
  datasetVersion              String
  engine                      String   // healthcare | care | grants | cross
  ruleCode                    String   // e.g. "H-MCD-01", "X-990-01"
  ruleName                    String
  ruleLibraryVersion          String   // e.g. "1.1.0"
  entitiesEvaluated           BigInt
  leadsPublished              BigInt
  // Null where the pipeline did not publish the count for the
  // rule's form (e.g. the date rule X-NPPES-01) — absence, not 0.
  aboveBandBeforeEffectFloor  BigInt?
  // Expected-by-construction count (band share × evaluated n),
  // published beside the lead count per PHASE6 §2.2. Null for
  // rule forms with no by-construction expectation.
  expectedByConstruction      Decimal? @db.Decimal(20, 2)
  // True when leadsPublished > 50% of expectedByConstruction
  // despite the floors (PHASE6 §2.2 disclosure). Null exactly
  // when expectedByConstruction is null.
  noiseCaution                Boolean?
  peerDefinition              String   @db.Text
  // The publisher's verbatim input-versions string, stored as a
  // JSON value so the provenance text travels losslessly.
  inputVersions               Json
  // Per-status counts from the closed not-computed vocabulary
  // (PHASE6 §3.4), as published: { status: count }.
  notComputed                 Json?

  createdAt                   DateTime @default(now())

  @@unique([datasetVersion, ruleCode])
  @@index([datasetVersion])
  @@index([datasetVersion, engine])
}

model FrDataQualityRecord {
  id                  String   @id @default(cuid())
  datasetSlug         String   // e.g. "grants-aggregates"
  datasetVersion      String   // e.g. "2026-10-06"
  runDate             String   // quality run vintage, e.g. "2026-10-31"
  // Overall state from the data-quality engine: pass | warn |
  // fail | error (worst check state for the dataset).
  verdict             String
  checksTotal         Int
  checksPass          Int
  checksWarn          Int
  checksFail          Int
  checksError         Int
  checksNotApplicable Int
  // Per-check states as published: { "Q-GRAIN": { "pass": 4 } }.
  checks              Json
  // Defect-register IDs in force for this dataset (PHASE6 §5.3).
  defectsInForce      String[]
  // Pointer into the quality.json artifact for the full record.
  detailPointer       String
  filesChecked        Int
  vintageAgeDays      Int

  createdAt           DateTime @default(now())

  @@unique([datasetSlug, datasetVersion, runDate])
  @@index([runDate])
  @@index([datasetSlug])
}

// Aurora alerts (item #21, approved 2026-10-31): preset-place aurora
// subscriptions for signed-in users (any tier). Derived fields
// (magLat, requiredKp) are snapshotted at subscribe time; the
// once-per-night sender claim lives in lastAlertNight. Logic:
// src/lib/aurora/.
model AuroraAlertSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeSlug     String
  placeName     String
  lat           Float
  lng           Float
  timeZone      String
  magLat        Float
  requiredKp    Float

  active        Boolean   @default(true)
  lastAlertNight String?
  lastAlertedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, placeSlug])
  @@index([active])
  @@index([userId])
}

// Browser push (wave-2 item 4, approved 2026-11-06): one row per
// browser/device push subscription a signed-in user has granted on
// this device. Delivery is a CHANNEL on the existing alert machinery
// (camera AlertRule transitions + EventAlertRule detections), decided
// by src/lib/account/delivery.ts (channel email | push | both | none);
// the send path lives in src/lib/push/. A user can hold several rows
// (phone + desktop); the endpoint is the subscription's identity —
// dead endpoints (404/410 from the push service) are pruned on send.
//
// NOTE: this table already EXISTS in production (created 2026-10-25
// by an earlier payload whose code never landed in the tree — it sat
// orphaned and empty). This model is shaped to the production table
// exactly (id/userId/endpoint/p256dh/auth/userAgent/createdAt/
// lastSeenAt, endpoint unique, user FK cascade) so the client reuses
// it as-is; lastSeenAt bumps on (re)subscribe and on each accepted
// send. The migration is idempotent for the same reason.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ── Fraud Radar Phase 7 — AI Investigator (PHASE7 §3.5, §4.4) ─────
// DB-persisted, per-user conversations for the investigator chat
// surface, plus its usage ledger. Conversations belong to the user
// who created them, full stop: every route filters by userId and a
// foreign conversation id reads as 404. The ledger is the quota
// source of truth (monthly ops = count of `charged` rows in the
// calendar month, UTC); it is keyed by userId/turnId as plain
// columns so Phase 11's entitlements adopt the table as-is.
// Platform admins see aggregate operations data only — never
// conversation content (PHASE7 §3.5). Dark behind fraudRadarEnabled.

model FrInvestigatorConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  FrInvestigatorMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model FrInvestigatorMessage {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   FrInvestigatorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | assistant
  role           String
  content        String                 @db.Text
  // The turn's §2.3 citation record: the full tool-result
  // envelopes as returned, in call order (assistant rows only).
  toolCalls      Json?
  model          String?
  promptVersion  String?
  inputTokens    Int?
  outputTokens   Int?
  // pass | regenerated | fallback (assistant rows; null while running)
  validatorVerdict String?
  // complete | running | error (a turn is the assistant row in flight)
  status         String                 @default("complete")
  errorCode      String?
  // The persisted SSE event log for the turn (§4.2 replay contract):
  // [{ seq, t, ... }] in emission order; [] for user rows.
  events         Json

  createdAt      DateTime               @default(now())

  @@index([conversationId, createdAt])
}

model FrInvestigatorUsageLedger {
  id               String   @id @default(cuid())
  userId           String
  conversationId   String
  // The assistant message id of the turn (1:1 with the turn).
  turnId           String   @unique
  // Tier at time of turn: free | plus | pro | teams.
  tier             String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  toolCallCount    Int      @default(0)
  // Estimate from the model's published per-token rates recorded
  // in config — an estimate, labelled as such wherever shown.
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  // charged | refunded | failed_free
  status           String   @default("charged")
  validatorVerdict String?

  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

// ── Fraud Radar Phase 8 — Cases & Evidence (PHASE8 §1) ────────────
// A user's private work product: cases (workspaces), pinned leads
// frozen as verbatim snapshots with their provenance blocks,
// vault evidence, notes, claims + verification runs, and an
// append-only activity log. Owner-isolated with 404-not-403
// semantics (resolveCaseAccess in src/lib/fraud-radar/cases/ is
// the only place access is decided); teamRef is OPAQUE — Phase 8
// creates no team table and no FK to the camera product's
// Organization model. Evidence is never part of the public corpus.
// Dark behind fraudRadarEnabled.

model FrCase {
  id          String @id @default(cuid())
  ownerId     String
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  summary     String? @db.Text
  // open | paused | closed — a user state, not a finding.
  status      String @default("open")

  // Team visibility (PHASE8 §1.5): private | team. teamRef is the
  // opaque identifier the Phase 11 entitlement interface resolves.
  visibility  String @default("private")
  teamRef     String?

  leads       FrCaseLead[]
  evidence    FrCaseEvidence[]
  notes       FrCaseNote[]
  claims      FrCaseClaim[]
  events      FrCaseEvent[]
  reports     FrReport[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime?

  @@index([ownerId, status, updatedAt])
  @@index([teamRef])
}

model FrCaseLead {
  id        String @id @default(cuid())
  caseId    String
  case      FrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // signal | screening | candidate | entity | investigator
  kind      String
  // healthcare | care | grants | contracts | cross
  engine    String
  entityKey String
  entityLabel String

  // The complete record AS RETURNED by the data layer at pin
  // time, stored verbatim and rendered verbatim forever
  // (PHASE8 §1.3). NEVER updated after creation — the data-access
  // layer exposes no update path for the snapshot fields.
  snapshot  Json
  snapshotSha256 String
  sourceDataset       String
  sourceDatasetVersion String
  ruleCode  String?

  pinnedById String
  pinnedAt   DateTime @default(now())
  annotation String? @db.Text

  notes     FrCaseNote[]

  @@index([caseId, pinnedAt])
  @@index([entityKey])
  @@unique([caseId, entityKey, ruleCode, snapshotSha256])
}

model FrCaseEvidence {
  id        String @id @default(cuid())
  caseId    String
  case      FrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // upload | artifact
  kind      String

  title     String
  description String? @db.Text

  originalFilename String?
  contentType      String?
  sizeBytes        BigInt?
  sha256           String?
  blobPathname     String?
  storageState     String @default("present")

  artifactEnvelope Json?
  artifactSha256   String?

  // not_requested | queued | processing | processed | failed
  processingStatus String @default("not_requested")
  // docling | text_extract | none
  processingPath   String?
  processorVersion String?
  extractedTextPathname String?
  pageCount        Int?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs      FrEvidenceProcessingJob[]
  notes     FrCaseNote[]

  @@index([caseId, createdAt])
  @@index([sha256])
}

model FrEvidenceProcessingJob {
  id         String @id @default(cuid())
  evidenceId String
  evidence   FrCaseEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  caseId     String
  // queued | processing | succeeded | failed
  status     String @default("queued")
  requestedPath String @default("auto")
  attempts   Int @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([evidenceId])
  @@index([caseId])
}

model FrCaseNote {
  id        String @id @default(cuid())
  caseId    String
  case      FrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       FrCaseLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  evidenceId String?
  evidence   FrCaseEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  claimId    String?
  claim      FrCaseClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  body      String @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, createdAt])
}

model FrCaseClaim {
  id        String @id @default(cuid())
  caseId    String
  case      FrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  statement String @db.Text
  subjectEngine    String?
  subjectEntityKey String?

  createdById String
  createdAt   DateTime @default(now())
  verifications FrClaimVerification[]
  notes         FrCaseNote[]

  @@index([caseId, createdAt])
}

model FrClaimVerification {
  id        String @id @default(cuid())
  claimId   String
  claim     FrCaseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // supported | contradicted | not-in-corpus | insufficient-data
  verdict   String
  evidence  Json
  summary   String @db.Text
  validatorVerdict String
  corpusVersions Json
  checkerVersion String
  model        String?
  promptVersion String?

  createdById String
  createdAt   DateTime @default(now())

  @@index([claimId, createdAt])
}

model FrCaseEvent {
  id        String @id @default(cuid())
  caseId    String
  case      FrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      String
  actorId   String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}


// exists in v1 (PHASE9 §0.7, blocker B-3).

model FrReport {
  id        String @id @default(cuid())
  ownerId   String
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional home case (templates B/F/G normally; A/C/D/E/H/I
  // may be caseless)
  caseId    String?
  case      FrCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  templateId String            // "A"…"I" (registry key, PHASE9 §1.4)
  title     String             // the author's title
  // draft | ready | archived — work states, never findings
  status    String @default("draft")

  versions  FrReportVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([caseId])
}

model FrReportVersion {
  id        String @id @default(cuid())
  reportId  String
  report    FrReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  versionNo Int                // 1, 2, 3… per report
  templateVersion String       // PHASE9 §1.4 — the exact template def used
  generatorVersion String      // REPORT_GENERATOR_VERSION (PHASE9 §3.2)

  // THE PIN SET (§2.1) + the author's section composition (§4):
  // frozen at creation; never updated.
  pinSet    Json
  composition Json

  // THE CANONICAL CONTENT (§2.4): the Report Document Model
  // produced by the generator — stored in Blob beside the
  // exports (large), hash + pointer here. Written ONCE by the
  // generation job, together with the manifest + validation.
  documentPathname String?
  contentSha256    String?
  manifest  Json?
  // pass | pass_with_user_text_warnings | failed (§3.4)
  validationVerdict String?
  validationDetail  Json?

  exports   FrReportExport[]
  jobs      FrReportGenerationJob[]

  createdById String
  createdAt DateTime @default(now())

  @@unique([reportId, versionNo])
  @@index([reportId, createdAt])
}

model FrReportExport {
  id         String @id @default(cuid())
  versionId  String
  version    FrReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  format     String            // pdf | docx | csv | json | zip
  blobPathname String          // fraud-radar-reports/<ownerId>/<reportId>/<versionId>/<file>
  sizeBytes  BigInt
  sha256     String            // of the exported file bytes
  contentSha256 String         // the document hash it was rendered from — must equal the version's
  createdAt  DateTime @default(now())

  @@index([versionId, format])
}

// GenerationJob shape (AUDIT §7; Phase 8 §1.4 precedent):
model FrReportGenerationJob {
  id         String @id @default(cuid())
  versionId  String
  version    FrReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reportId   String            // denormalised for claim query + tenant checks
  ownerId    String            // denormalised likewise
  formats    Json              // requested formats ["pdf","zip",…]
  // queued | processing | succeeded | failed
  status     String @default("queued")
  attempts   Int @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([versionId])
}

// ── White Label demo generator (pick #9, 2026-11-01) ───────────────────
// A public, shareable ILLUSTRATIVE preview a prospect generates for
// themselves on /white-label/demo: their organisation name + uploaded
// logo over a wall of redistribution-cleared cameras near a location
// they pick. The preview is a sales concept mock, not a product: the
// [slug] page is labelled "Illustrative preview" persistently and is
// noindex. `slug` is an unguessable random token (the share link);
// `cameraIds` snapshots the eligible camera ids chosen at generation
// time — the page re-validates eligibility at render, so a camera that
// later loses clearance drops out instead of leaking. Demo REQUESTS do
// not live here: they extend the ContactMessage lead store (topic
// "white-label-demo", src/lib/white-label) like the /white-label form.
model WhiteLabelPreview {
  id             String   @id @default(cuid())
  slug           String   @unique
  orgName        String
  // Vercel Blob URL of the visitor-uploaded logo; null = the preview
  // renders the organisation name as a text wordmark instead.
  logoUrl        String?
  locationLabel  String
  locationDetail String?
  lat            Float
  lng            Float
  cameraIds      String[] @default([])
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ── Fraud Radar Phase 11 (SHV-11) — billing + usage (PHASE11 §§1,3) ──
// A SEPARATE subscription model: the house Subscription.userId is
// @unique for the camera product, so Fraud Radar can never ride that
// row (AUDIT §6). Neither table knows the other exists. Additive
// only; dark behind fraudRadarEnabled; NO Stripe objects exist for
// these plans (P11-H is the owner's operations step, deferred).
model FraudRadarSubscription {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String @unique
  stripeSubscriptionId String @unique
  stripePriceId        String

  // plus | pro | teams (stored at write time via billing/prices.ts)
  plan        String
  // month | year
  interval    String

  // Stripe status mirrored verbatim: incomplete | incomplete_expired |
  // trialing | active | past_due | canceled | unpaid | paused
  status      String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  trialStart  DateTime?
  trialEnd    DateTime?

  // Teams only: seats the subscription pays for (base 5). Null else.
  seatsPurchased Int?

  // Comp grants (§3.6): synthetic Stripe ids, written only by the
  // comp module; the webhook never touches comp rows.
  isComp      Boolean @default(false)
  compSource  String?
  compGrantedBy String?
  compReason  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([stripePriceId])
}

// Webhook idempotency + audit (model ships in SHV-11; the webhook
// dispatch that writes it is P11-C, deferred by design).
model FrBillingEvent {
  id            String @id @default(cuid())
  stripeEventId String @unique
  type          String
  processedAt   DateTime @default(now())
  // applied | ignored_unknown_price | ignored_test_mode | failed
  outcome       String
  error         String?

  @@index([type, processedAt])
}

// The append-only metering ledger (§3.3) — the cross-kind quota
// source of truth. Rows are NEVER updated or deleted; a reversal is
// a NEW row with reversalOfId set. Domain tables (Phase 7/8
// ledgers, FrClaimVerification rows) remain the detail record.
model FrUsageLedger {
  id        String @id @default(cuid())
  userId    String
  teamId    String?
  // investigator_turn | claim_verification | evidence_processing |
  // report_generation
  kind      String
  units     Int @default(1)
  reversalOfId String?
  refType   String?
  refId     String?
  model     String?
  inputTokens  Int?
  outputTokens Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  tierAtCharge String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([teamId, kind, createdAt])
  @@index([reversalOfId])
}

model DemoJob {
  id          String     @id @default(cuid())
  prompt      String     @db.Text
  // Scene plan the worker executes: { template, steps: [...] } — written
  // by the planner at creation; the queue response is self-describing.
  plan        Json
  style       String     @default("cinematic")
  orientation String     @default("landscape")
  // queued | claimed | recording | rendering | complete | failed
  status      String     @default("queued")
  progress    String?
  error       String?    @db.Text
  videoId     String?
  video       DemoVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdBy   String?
  createdAt   DateTime   @default(now())
  claimedAt   DateTime?
  completedAt DateTime?

  @@index([status, createdAt])
}

model DemoVideo {
  id              String          @id @default(cuid())
  title           String
  description     String?         @db.Text
  // Demonstrated feature tags, e.g. ["globe","search","cameras","flights"].
  features        Json
  prompt          String          @db.Text
  style           String          @default("cinematic")
  orientation     String          @default("landscape")
  durationSec     Float?
  // Vercel Blob URLs: edited master + original recording + poster frame.
  videoUrl        String
  rawUrl          String?
  posterUrl       String?
  // draft | approved — only approved videos can be placed or shared.
  status          String          @default("draft")
  affiliateShared Boolean         @default(false)
  // Set by an admin when the site UI has changed enough that this demo
  // may misrepresent it; drives the Regenerate flow. Never auto-set on
  // a schedule — detection is advisory (Phase 5).
  outdated        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobs            DemoJob[]
  placements      DemoPlacement[]

  @@index([status, createdAt])
  @@index([affiliateShared, status])
}

model DemoPlacement {
  id        String    @id @default(cuid())
  videoId   String
  video     DemoVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Registry keys from lib/demo-studio/pages.ts (page + slot).
  page      String
  slot      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([page, slot, videoId])
  @@index([page, slot, active])
}

// ── Shareable camera collections (visitor feature, 2026-11-01) ─────
// A signed-in visitor's themed, PUBLIC collection of catalogue
// cameras ("Best Ski Cameras", "Tokyo Live Views"…). Distinct from
// the enterprise CameraCollection above: that is the API/team feed
// product; this one exists to be shared — a public page at
// /collections/<slug> and an embed at /embed/collection/<slug> that
// carries only rights-cleared cameras (lib/enterprise/rights).
// Membership stores catalogue ids only; names, frames and rights
// verdicts resolve at read time against the live catalogue, so a
// camera that leaves the catalogue or loses clearance drops out of
// the embed without any row changing.
model SharedCollection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  // Public, URL-safe, unique. Minted at create from the title plus a
  // random suffix; never changes afterwards, so renames keep every
  // shared link and embed alive.
  slug        String   @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       SharedCollectionItem[]

  @@index([userId])
}

model SharedCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   SharedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Catalogue camera id (src/app/api/cctv records), validated against
  // the catalogue before the row is written.
  cameraId     String
  // Owner-chosen order on the public page and in the embed.
  position     Int
  createdAt    DateTime @default(now())

  @@unique([collectionId, cameraId])
  @@index([collectionId, position])
}

// ── Fraud Radar Phase 10: graphs + geo Neon grain ─────────────────
// Summary grain ONLY (PHASE10 §6.6): one graph row per composite
// vintage, geo state cells + per-layer national summaries mirroring
// geo-neon.json 1:1. No per-entity or per-edge rows in Neon, ever
// (§3.2) — extracts live in the versioned artifacts. Candidate
// edges are counted separately and carry the measured linkage
// rates from the pipeline manifest — never recomputed in the app,
// never merged into the published-edge totals (§2.3). Geo withheld
// small cells carry NULL value/entity counts with attributionState
// "withheld_small_cell" — absence, never zero (§5.3).

model FrGraphYearlySummary {
  id                           String   @id @default(cuid())
  datasetVersion               String   @unique // composite graph vintage
  graphCatalogVersion          String
  entitiesTotal                BigInt
  entitiesUei                  Int
  entitiesEin                  Int
  entitiesNpi                  Int
  nodesTotal                   BigInt
  edgesExcludingCandidates     BigInt
  candidateEdges               BigInt
  annotations                  BigInt
  truncations                  BigInt
  candidateMatchRatePct        Decimal? @db.Decimal(10, 4)
  candidateAsDesignedRatePct   Decimal? @db.Decimal(10, 4)

  createdAt                    DateTime @default(now())

  @@index([datasetVersion])
}

model FrGeoStateSummary {
  id               String   @id @default(cuid())
  datasetVersion   String
  engine           String
  layer            String
  geographyField   String
  stateCode        String
  stateName        String
  attributionState String   // attributed | no_published_records | withheld_small_cell
  entityCount      Int?
  awardCount       BigInt?
  value            Decimal? @db.Decimal(24, 2)
  values           Json

  createdAt        DateTime @default(now())

  @@unique([datasetVersion, engine, layer, stateCode])
  @@index([datasetVersion, engine, layer])
}

model FrGeoYearlySummary {
  id                String   @id @default(cuid())
  datasetVersion    String
  engine            String
  layer             String
  geographyField    String
  national          Json
  unknown           Json
  coverageStatement String

  createdAt         DateTime @default(now())

  @@unique([datasetVersion, engine, layer])
  @@index([datasetVersion])
}

// ── Content Studio (autonomous content engine) admin controls ────────
// The admin panel at /admin/content-studio sets control state ONLY —
// modes, pauses — for the content engine that runs on Cosmo's VM
// (~/workspace/content-engine, SQLite store is its system of record).
// The panel never publishes anything itself. The engine reads control
// state through /api/internal/content-studio/controls and pushes
// status snapshots back; the snapshot table below is that read model.
//
// Platform rows are seeded by the migration. One reserved row,
// platform = "__global__", carries the global pause flag in `paused`;
// it is not a platform and is never listed as one.
model ContentPlatformState {
  platform         String   @id
  // manual | hybrid | autonomous — never above `ceiling` (enforced
  // server-side on every write; ceilings mirror the engine's store:
  // reddit manual forever, tiktok hybrid max).
  mode             String   @default("manual")
  ceiling          String   @default("manual")
  paused           Boolean  @default(false)
  // Free-form connection status string written by the seed/sync, e.g.
  // connected_studio_browser | link_dropped | draft_only.
  connectionStatus String   @default("not_connected")
  updatedAt        DateTime @updatedAt
}

// One row per control change made from the admin panel (the engine
// polls these via the internal controls endpoint and applies the ones
// it has not seen; application is idempotent on the engine side).
model ContentControlEvent {
  id        String   @id @default(cuid())
  actor     String?
  action    String
  platform  String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Status snapshots pushed by the engine (sections: overview | queue |
// errors). The panel renders ONLY what the latest snapshot per section
// carries — no snapshot, no numbers.
model ContentEngineSnapshot {
  id        String   @id @default(cuid())
  section   String
  payload   Json
  createdAt DateTime @default(now())

  @@index([section, createdAt])
}

// Instagram OAuth handshake store for the Multilogin fleet's per-account
// Instagram Login flow. The fleet registers a single-use state nonce
// (SHA-256 hash only — the raw nonce never touches the database) via
// /api/instagram/issue; Instagram redirects the authorization code to
// /api/instagram/callback, which stores it against the nonce; the fleet
// picks the code up exactly once via /api/instagram/pickup by presenting
// the raw nonce, which burns it. Codes are credentials: held only until
// pickup, then nulled. Rows expire 15 minutes after issue.

model IgOAuthHandshake {
  id         String    @id @default(cuid())
  nonceHash  String    @unique
  username   String
  code       String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  pickedUpAt DateTime?

  @@index([expiresAt])
}
